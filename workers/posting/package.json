{
  "name": "command-center-posting",
  "private": true,
  "description": "Playwright scripts that post approved ads to marketplaces (see PRD: Auto-Post Approved Ads)",
  "scripts": {
    "capture-login": "tsx capture-login.ts",
    "post": "tsx post.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json --noEmit false --outDir /tmp/posting-test-build && node --test /tmp/posting-test-build/*.test.js"
  },
  "dependencies": {
    "playwright": "^1.45.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
